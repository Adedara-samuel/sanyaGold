# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.sanyagold.com

# ─── Email (contact form + consultation requests) ───────────────────────
# Sender account. For Gmail, SMTP_PASS must be a Google App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-app-password

# Inbox that receives every enquiry and booking request.
# Leave empty to use the email shown on the website (siteConfig.contact.email).
CONTACT_TO_EMAIL=info@sanyagold.com

# Optional, cookieless analytics (https://plausible.io). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
